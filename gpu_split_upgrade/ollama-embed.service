[Unit]
Description=Ollama Embedding Service (P100)
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"
Environment="OLLAMA_MODELS=/mnt/ai-data/ollama/models"
Environment="OLLAMA_HOST=127.0.0.1:11435"
Environment="CUDA_VISIBLE_DEVICES=GPU-685c9973-bece-68da-c697-474881571cee"
Environment="OLLAMA_LLM_LIBRARY=cuda_v12"

[Install]
WantedBy=multi-user.target

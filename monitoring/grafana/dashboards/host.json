{"uid":"i3s-host","title":"Host","schemaVersion":41,"version":1,"panels":[{"type":"timeseries","title":"CPU %","targets":[{"expr":"100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"}]},{"type":"timeseries","title":"RAM %","targets":[{"expr":"100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"}]},{"type":"timeseries","title":"Load","targets":[{"expr":"node_load1"}]},{"type":"timeseries","title":"Disk %","targets":[{"expr":"100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})"}]},{"type":"timeseries","title":"Container CPU","targets":[{"expr":"sum by(name) (rate(container_cpu_usage_seconds_total{name=~\"(open-webui|litellm|tika)\"}[5m]))"}]}]}

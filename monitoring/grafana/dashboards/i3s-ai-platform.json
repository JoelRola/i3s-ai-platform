{"uid":"i3s-ai-platform","title":"I3S AI Platform","schemaVersion":41,"version":2,"refresh":"15s","time":{"from":"now-1h","to":"now"},"panels":[{"id":1,"type":"stat","title":"Service health (all private services)","gridPos":{"x":0,"y":0,"w":24,"h":5},"targets":[{"expr":"i3s_service_up","legendFormat":"{{service}}"}],"fieldConfig":{"defaults":{"unit":"none","thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":1}]}}}},{"id":2,"type":"timeseries","title":"A100 and P100 GPU utilisation","gridPos":{"x":0,"y":5,"w":12,"h":8},"targets":[{"expr":"nvidia_gpu_utilization_percent","legendFormat":"{{gpu_name}}"}],"fieldConfig":{"defaults":{"unit":"percent"}}},{"id":3,"type":"timeseries","title":"A100 and P100 VRAM used / total","gridPos":{"x":12,"y":5,"w":12,"h":8},"targets":[{"expr":"nvidia_gpu_memory_used_bytes","legendFormat":"{{gpu_name}} used"},{"expr":"nvidia_gpu_memory_total_bytes","legendFormat":"{{gpu_name}} total"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},{"id":4,"type":"timeseries","title":"GPU temperature","gridPos":{"x":0,"y":13,"w":12,"h":8},"targets":[{"expr":"nvidia_gpu_temperature_celsius","legendFormat":"{{gpu_name}}"}],"fieldConfig":{"defaults":{"unit":"celsius"}}},{"id":5,"type":"timeseries","title":"GPU power","gridPos":{"x":12,"y":13,"w":12,"h":8},"targets":[{"expr":"nvidia_gpu_power_watts","legendFormat":"{{gpu_name}}"}],"fieldConfig":{"defaults":{"unit":"watt"}}},{"id":6,"type":"timeseries","title":"LiteLLM active requests","gridPos":{"x":0,"y":21,"w":12,"h":8},"targets":[{"expr":"litellm_in_flight_requests","legendFormat":"in flight"}]},{"id":7,"type":"timeseries","title":"LiteLLM active users","gridPos":{"x":12,"y":21,"w":12,"h":8},"targets":[{"expr":"litellm_active_users","legendFormat":"active users"}]},{"id":8,"type":"timeseries","title":"Host CPU","gridPos":{"x":0,"y":29,"w":8,"h":8},"targets":[{"expr":"100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)","legendFormat":"CPU"}],"fieldConfig